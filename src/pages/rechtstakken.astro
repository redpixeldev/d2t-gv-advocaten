---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Cta from '@components/Cta.astro';
---

<Layout title='Astro'>
	<Header />
	<div class='relative'>
		<img src="/img/bg-hero-rechtstakken.jpg" class="absolute inset-0 w-full h-full object-cover" alt="">
		<div class="container max-w-7xl min-h-[520px] md:min-h-[480px] relative z-20 pt-16 md:pt-10 sm:pt-7 lg:pt-0">
			<div class="flex justify-center mb-12 md:mb-10">
				<div class="px-18 py-px bg-white w-full text-center md:w-auto">
					<p class="text-brand-dark font-bold">Rechtstakken</p>
				</div>
			</div>
			<div class="md:w-2/5 bg-[#f8f8f8] p-11 lg:p-13">
				<ul class="list-disc list-inside space-y-1">
					<li>Personen- en familierecht</li>
					<li>Ondernemingsrecht</li>
					<li>Vastgoedrecht</li>
					<li>Bancair recht</li>
					<li>Strafrecht</li>
					<li>Contractenrecht</li>
					<li>Verzekerings- en aansprakelijkheidsrecht</li>
					<li>Huurrecht en handelshuur</li>
					<li>Verkeersrecht</li>
				</ul>
			</div>
		</div>
	</div>
	<div class="container max-w-7xl py-16">
		<div class="lg:w-[90%] xl:w-5/6 mx-auto pb-10">
			<div class="flex justify-center">
				<div class="px-18 py-px bg-brand-primary text-center mb-8 inline-block">
					<p class="text-white font-bold uppercase">ONZE EXPERTISE.</p>
				</div>
			</div>
			<div class="flex flex-col md:flex-row gap-10">
				<div class="md:w-1/2">
					<img src="/img/people-smiling-image.jpg" class="w-full h-auto" alt="">
				</div>
				<div class="md:w-1/2 lg:mr-16">
					<h2 class="pb-7 md:pb-10 font-bold text-lg">UW RECHT.<br/> <span class="text-brand-primary">ONZE EXPERTISE.</span></h2>
					<p class="text-brand-dark text-left">TAls moderne rechtspraktijk zijn we thuis in alle voornaamste rechtsdomeinen. We hebben een bijzondere expertise in het personen- en familierecht, verzekerings- en aansprakelijkheidsrecht. Daarnaast kunnen wij u bijstaan met advies in strafrecht en verkeer, handels- en economisch recht, bouw- en vastgoedrecht.  Bij zeer specifieke materies kan ons kantoor bogen op de intensieve samenwerking met collega- specialisten in alle branches van het recht.</p>
				</div>
			</div>
		</div>
		<div class="bg-[#f8f8f8] p-8 sm:p-12">
			<ul class="list-decimal list-inside space-y-1 md:w-4/5 mx-auto">
				<li><span class="font-bold">Personen- en familierecht:</span> echtscheidingen, verblijfs- en onderhoudsregeling kinderen, afstamming/adoptie, huwelijksvermogensrecht, erfenissen, schenkingen, testamenten,…</li>
				<li><span class="font-bold">Ondernemingsrecht:</span> incasso, handelsrecht, aannemingsrecht (bouwzaken) en commerciële geschillen</li>
				<li><span class="font-bold">Burgerlijk recht en contractenrecht:</span> algemene en bijzondere contracten, koop-verkoop, woninghuur, handelshuur, gemeenrechtelijke huur</li>
				<li><span class="font-bold">Bancair recht:</span> wet op consumentenkrediet, wet op het hypothecair krediet</li>
				<li><span class="font-bold">Strafrecht:</span> strafrechtelijke verdediging, burgerlijke partijstelling, salduz-bijstand verhoor, …</li>
				<li><span class="font-bold">Verzekerings- en aansprakelijkheidsrecht:</span> verkeersrecht, letselschade, rechtsbijstand, …</li>
				<li><span class="font-bold">Vastgoedrecht:</span> eigendom, vruchtgebruik, erfdienstbaarheden, burenhinder, …</li>
			</ul>
		</div>
	</div>
	<Cta />
	<div class="relative">
		<img src="/img/bg-contact.jpg" class="absolute inset-0 w-full h-full object-cover object-top" alt="">
		<div class="container max-w-7xl md:pb-10 pb-16 pt-16 lg:pt-28 relative z-20">
			<form class="md:w-3/5 lg:w-2/5 bg-white p-6">
				<p class="italic uppercase text-brand-dark text-xs pb-4 lg:pb-6"><span class="text-[#eb5448]">*</span> Indicates required field</p>
				<div class="pb-5">
					<label for="Name" class="uppercase text-brand-dark font-bold pb-[2px] block">Naam <span class="text-[#eb5448]">*</span></label>
					<div class="flex gap-5">
						<input type="text" placeholder="First" class="w-1/2 bg-[#e5e5e5] border-0 hover:bg-white hover:shadow transition-colors duration-300 placeholder-[#a8a9a9] text-black">
						<input type="text" placeholder="Last" class="w-1/2 bg-[#e5e5e5] border-0 hover:bg-white hover:shadow transition-colors duration-300 placeholder-[#a8a9a9] text-black">
					</div>
				</div>
				<div class="pb-5">
					<label for="email" class="uppercase text-brand-dark font-bold pb-[2px] block">Email<span class="text-[#eb5448]">*</span></label>
					<input type="text" placeholder="Email" class="w-full bg-[#e5e5e5] border-0 hover:bg-white hover:shadow transition-colors duration-300 placeholder-[#a8a9a9] text-black">
				</div>
				<div class="pb-5">
					<label for="message" class="uppercase text-brand-dark font-bold pb-[2px] block">Uw vraag<span class="text-[#eb5448]">*</span></label>
					<textarea rows="4" name="message" id="message" class="w-full bg-[#e5e5e5] border-0 hover:bg-white hover:shadow transition-colors duration-300 placeholder-[#a8a9a9] text-black"></textarea>
				</div>
				<button class="btn-primary">Versturen</button>
			</form>
		</div>
	</div>
	<Footer />
</Layout>
